{# ============================================================
   TEMPLATE BASE: Página de servicio individual
   Usar con datos inyectados desde cada archivo .njk
   ============================================================ #}

{% set s = servicio %}

<style>
  /* ── Hero ── */
  .svc-hero {
    background: var(--dark-2);
    border-bottom: 1px solid var(--border-subtle);
    padding: 52px 0 44px;
  }
  .svc-hero-inner {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 40px;
  }
  .svc-breadcrumb {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 20px;
    font-family: var(--font-display);
    font-size: 0.72rem;
    letter-spacing: 1.5px;
    text-transform: uppercase;
  }
  .svc-breadcrumb a { color: var(--text-muted); text-decoration: none; }
  .svc-breadcrumb a:hover { color: var(--yellow); }
  .svc-breadcrumb span { color: var(--text-muted); opacity: 0.4; }
  .svc-breadcrumb strong { color: var(--text-light); font-weight: 600; }

  .svc-hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    background: var(--yellow-dim);
    border: 1px solid var(--yellow);
    border-radius: 2px;
    padding: 5px 12px;
    font-family: var(--font-display);
    font-size: 0.68rem;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--yellow);
    margin-bottom: 16px;
  }
  .svc-hero h1 {
    font-size: clamp(2rem, 4vw, 3.2rem);
    margin: 0 0 14px;
    color: var(--text-light);
    line-height: 1.15;
  }
  .svc-hero-lead {
    font-size: 1.05rem;
    font-weight: 300;
    color: var(--text-muted);
    max-width: 680px;
    line-height: 1.75;
    margin: 0 0 28px;
  }
  .svc-hero-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
    margin-top: 8px;
  }
  .svc-meta-chip {
    display: flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-display);
    font-size: 0.75rem;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: var(--text-muted);
  }
  .svc-meta-chip svg {
    width: 14px; height: 14px;
    color: var(--yellow);
    flex-shrink: 0;
  }

  /* ── Layout principal ── */
  .svc-page-wrap {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 60px 40px 80px;
    display: grid;
    grid-template-columns: 1fr 320px;
    gap: 60px;
    align-items: start;
  }
  .svc-main { min-width: 0; }
  .svc-sidebar { position: sticky; top: 100px; }

  /* ── Sección: descripción ── */
  .svc-section { margin-bottom: 56px; }
  .svc-section-label {
    font-family: var(--font-display);
    font-size: 0.68rem;
    letter-spacing: 2.5px;
    text-transform: uppercase;
    color: var(--yellow);
    display: block;
    margin-bottom: 10px;
  }
  .svc-section h2 {
    font-size: clamp(1.3rem, 2.2vw, 1.8rem);
    color: var(--text-light);
    margin: 0 0 20px;
  }
  .svc-section p {
    font-size: 0.95rem;
    font-weight: 300;
    line-height: 1.85;
    color: var(--text-muted);
    margin: 0 0 16px;
  }

  /* ── Incluye ── */
  .svc-includes-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2px;
    margin-top: 8px;
  }
  .svc-include-item {
    background: var(--dark-3);
    padding: 18px 22px;
    display: flex;
    align-items: flex-start;
    gap: 12px;
  }
  .svc-include-item svg {
    width: 16px; height: 16px;
    color: var(--yellow);
    flex-shrink: 0;
    margin-top: 2px;
  }
  .svc-include-item span {
    font-size: 0.88rem;
    color: var(--text-muted);
    line-height: 1.6;
  }

  /* ── FAQ ── */
  .svc-faq { border-top: 1px solid var(--border-subtle); }
  .faq-item {
    border-bottom: 1px solid var(--border-subtle);
  }
  .faq-question {
    width: 100%;
    background: none;
    border: none;
    padding: 20px 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    cursor: pointer;
    text-align: left;
  }
  .faq-question span {
    font-family: var(--font-display);
    font-size: 0.92rem;
    font-weight: 600;
    color: var(--text-light);
    text-transform: uppercase;
    letter-spacing: 0.5px;
    line-height: 1.4;
  }
  .faq-icon {
    width: 18px; height: 18px;
    color: var(--yellow);
    flex-shrink: 0;
    transition: transform 0.25s;
  }
  .faq-item.open .faq-icon { transform: rotate(45deg); }
  .faq-answer {
    display: none;
    padding: 0 0 20px;
    font-size: 0.92rem;
    font-weight: 300;
    line-height: 1.85;
    color: var(--text-muted);
  }
  .faq-item.open .faq-answer { display: block; }

  /* ── Sidebar ── */
  .sidebar-card {
    background: var(--dark-3);
    border: 1px solid var(--border-subtle);
    border-top: 3px solid var(--yellow);
    padding: 28px 28px 24px;
    margin-bottom: 16px;
  }
  .sidebar-card h3 {
    font-family: var(--font-display);
    font-size: 0.78rem;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--yellow);
    margin: 0 0 16px;
  }
  .sidebar-card p {
    font-size: 0.88rem;
    font-weight: 300;
    color: var(--text-muted);
    line-height: 1.7;
    margin: 0 0 20px;
  }
  .sidebar-card .btn-primary {
    width: 100%;
    display: block;
    text-align: center;
    font-size: 0.85rem;
    padding: 12px 20px;
    box-sizing: border-box;
  }

  .sidebar-norms {
    background: var(--dark-2);
    border: 1px solid var(--border-subtle);
    padding: 20px 24px;
    margin-bottom: 16px;
  }
  .sidebar-norms h4 {
    font-family: var(--font-display);
    font-size: 0.68rem;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--text-muted);
    margin: 0 0 12px;
  }
  .norm-tag {
    display: inline-block;
    background: var(--dark-3);
    border: 1px solid var(--border-subtle);
    padding: 4px 10px;
    font-family: var(--font-display);
    font-size: 0.7rem;
    letter-spacing: 1px;
    color: var(--text-muted);
    margin: 0 4px 6px 0;
  }

  .sidebar-related h4 {
    font-family: var(--font-display);
    font-size: 0.68rem;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--text-muted);
    margin: 0 0 12px;
  }
  .related-link {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px 0;
    border-bottom: 1px solid var(--border-subtle);
    text-decoration: none;
    color: var(--text-muted);
    font-size: 0.86rem;
    transition: color 0.2s;
  }
  .related-link:last-child { border-bottom: none; }
  .related-link:hover { color: var(--yellow); }
  .related-link svg { width: 12px; height: 12px; flex-shrink: 0; color: var(--yellow); }

  /* ── CTA final ── */
  .svc-final-cta {
    background: var(--dark-2);
    border: 1px solid var(--border-subtle);
    border-left: 3px solid var(--yellow);
    padding: 36px 40px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
    flex-wrap: wrap;
    margin-top: 40px;
  }
  .svc-final-cta h3 {
    font-family: var(--font-display);
    font-size: 1.15rem;
    color: var(--text-light);
    margin: 0 0 6px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }
  .svc-final-cta p {
    font-size: 0.9rem;
    color: var(--text-muted);
    margin: 0;
    font-weight: 300;
  }

  /* ── Responsive ── */
  @media (max-width: 960px) {
    .svc-page-wrap {
      grid-template-columns: 1fr;
      padding: 40px 20px 60px;
      gap: 40px;
    }
    .svc-sidebar { position: static; }
    .svc-hero-inner { padding: 0 20px; }
    .svc-includes-grid { grid-template-columns: 1fr; }
    .svc-final-cta { padding: 24px 20px; }
  }
</style>

<!-- HERO -->
<div class="svc-hero">
  <div class="svc-hero-inner">
    <nav class="svc-breadcrumb" aria-label="Breadcrumb">
      <a href="/">Inicio</a>
      <span>›</span>
      <a href="/servicios/">Servicios</a>
      <span>›</span>
      <strong>{{ s.titulo }}</strong>
    </nav>
    {% if s.badge %}
      <div class="svc-hero-badge">{{ s.badge }}</div>
    {% endif %}
    <h1>{{ s.h1 }}</h1>
    <p class="svc-hero-lead">{{ s.lead }}</p>
    <div class="svc-hero-meta">
      <span class="svc-meta-chip">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg>
        CDMX y Estado de México
      </span>
      <span class="svc-meta-chip">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
        20 años de experiencia
      </span>
      {% if s.metachip %}
      <span class="svc-meta-chip">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
        {{ s.metachip }}
      </span>
      {% endif %}
    </div>
  </div>
</div>

<!-- CONTENIDO PRINCIPAL + SIDEBAR -->
<div class="svc-page-wrap">

  <!-- COLUMNA PRINCIPAL -->
  <main class="svc-main">

    <!-- Descripción detallada -->
    <section class="svc-section">
      <span class="svc-section-label">Descripción del servicio</span>
      <h2>{{ s.seccion1_titulo }}</h2>
      {% for parrafo in s.descripcion %}
        <p>{{ parrafo }}</p>
      {% endfor %}
    </section>

    <!-- Lo que incluye -->
    <section class="svc-section">
      <span class="svc-section-label">Alcance del servicio</span>
      <h2>¿Qué incluye?</h2>
      <div class="svc-includes-grid">
        {% for item in s.incluye %}
        <div class="svc-include-item">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="20 6 9 17 4 12"/>
          </svg>
          <span>{{ item }}</span>
        </div>
        {% endfor %}
      </div>
    </section>

    <!-- FAQ -->
    <section class="svc-section">
      <span class="svc-section-label">Preguntas frecuentes</span>
      <h2>Lo que nos preguntan antes de contratar</h2>
      <div class="svc-faq">
        {% for faq in s.faqs %}
        <div class="faq-item">
          <button class="faq-question" aria-expanded="false">
            <span>{{ faq.q }}</span>
            <svg class="faq-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
              <line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/>
            </svg>
          </button>
          <div class="faq-answer">{{ faq.a }}</div>
        </div>
        {% endfor %}
      </div>
    </section>

    <!-- CTA final -->
    <div class="svc-final-cta">
      <div>
        <h3>{{ s.cta_titulo }}</h3>
        <p>{{ s.cta_sub }}</p>
      </div>
      <a href="/contacto/" class="btn-primary">Solicitar cotización →</a>
    </div>

  </main>

  <!-- SIDEBAR -->
  <aside class="svc-sidebar">

    <div class="sidebar-card">
      <h3>¿Necesitas este servicio?</h3>
      <p>Cotización sin costo. Respondemos en menos de 24 horas hábiles.</p>
      <a href="/contacto/" class="btn-primary">Contactar ahora</a>
    </div>

    {% if s.normas %}
    <div class="sidebar-norms">
      <h4>Normativa aplicable</h4>
      {% for norma in s.normas %}
        <span class="norm-tag">{{ norma }}</span>
      {% endfor %}
    </div>
    {% endif %}

    {% if s.relacionados %}
    <div class="sidebar-related">
      <h4>Servicios relacionados</h4>
      {% for rel in s.relacionados %}
      <a href="{{ rel.url }}" class="related-link">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><polyline points="9 18 15 12 9 6"/></svg>
        {{ rel.nombre }}
      </a>
      {% endfor %}
    </div>
    {% endif %}

  </aside>

</div>

<script>
document.querySelectorAll('.faq-question').forEach(btn => {
  btn.addEventListener('click', () => {
    const item = btn.closest('.faq-item');
    const isOpen = item.classList.contains('open');
    document.querySelectorAll('.faq-item.open').forEach(i => {
      i.classList.remove('open');
      i.querySelector('.faq-question').setAttribute('aria-expanded', 'false');
    });
    if (!isOpen) {
      item.classList.add('open');
      btn.setAttribute('aria-expanded', 'true');
    }
  });
});
</script>
